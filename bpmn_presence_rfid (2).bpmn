  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:collaboration id="Collaboration_1">
<bpmn:participant id="Participant_1" name="Systeme de presence intelligent par badge RFID (Ecole)" processRef="Process_presence_rfid"/>
</bpmn:collaboration>
<bpmn:process id="Process_presence_rfid" name="Systeme de presence intelligent par badge RFID" isExecutable="false">
<bpmn:laneSet id="LaneSet_1">
<bpmn:lane id="lane_etu" name="Etudiant / Declencheurs"><bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef><bpmn:flowNodeRef>StartEvent_2</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="lane_iot" name="ESP32 / IoT (capteur RFID)"><bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="lane_fus" name="Fusion (automatisation)"><bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_1</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_2</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_2</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_3</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_6</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_3</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_4</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_7</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_8</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_5</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="lane_adm" name="Administration / ecole"><bpmn:flowNodeRef>Task_9</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_10</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="StartEvent_1" name="Etudiant badge sa carte RFID"></bpmn:startEvent>
<bpmn:task id="Task_1" name="Lire UID + publier via MQTT"/>
<bpmn:task id="Task_2" name="Recevoir le message MQTT"/>
<bpmn:task id="Task_3" name="Rechercher l'etudiant (SELECT students)"/>
<bpmn:exclusiveGateway id="Gateway_1" name="Etudiant reconnu ?"/>
<bpmn:endEvent id="EndEvent_1" name="Carte non reconnue"/>
<bpmn:task id="Task_4" name="Verifier si deja badge aujourd'hui"/>
<bpmn:exclusiveGateway id="Gateway_2" name="Deja badge aujourd'hui ?"/>
<bpmn:endEvent id="EndEvent_2" name="Ignore (doublon)"/>
<bpmn:task id="Task_5" name="Enregistrer presence (event + upsert)"/>
<bpmn:endEvent id="EndEvent_3" name="Presence enregistree"/>
<bpmn:startEvent id="StartEvent_2" name="Cron 08h31 (lun-ven) ou declenchement manuel"><bpmn:timerEventDefinition/></bpmn:startEvent>
<bpmn:task id="Task_6" name="Rechercher les eleves absents (SQL)"/>
<bpmn:exclusiveGateway id="Gateway_3" name="Des absents ?"/>
<bpmn:endEvent id="EndEvent_4" name="Aucune alerte a envoyer"/>
<bpmn:task id="Task_7" name="Construire le message d'alerte"/>
<bpmn:task id="Task_8" name="Enregistrer les alertes (table alerts)"/>
<bpmn:task id="Task_9" name="Envoyer un e-mail (Gmail)"/>
<bpmn:task id="Task_10" name="Envoyer une notification Slack"/>
<bpmn:endEvent id="EndEvent_5" name="Alertes envoyees"/>
