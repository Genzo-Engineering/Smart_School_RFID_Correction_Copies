<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:collaboration id="Collaboration_1">
<bpmn:participant id="Participant_1" name="Correction automatique d'examens par IA" processRef="Process_correction_examens"/>
</bpmn:collaboration>
<bpmn:process id="Process_correction_examens" name="Correction automatique d'examens par IA" isExecutable="false">
<bpmn:laneSet id="LaneSet_1">
<bpmn:lane id="lane_etu" name="Enseignant / declencheur"><bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="lane_drv" name="Google Drive"><bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="lane_ocr" name="OCR (Mistral)"><bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="lane_ia" name="Agent IA (correction)"><bpmn:flowNodeRef>Gateway_1</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_6</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_2</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="lane_out" name="Sorties (Supabase + Google Docs)"><bpmn:flowNodeRef>Task_7</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_8</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_2</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="StartEvent_1" name="Nouveau fichier depose (copie + corrige)"><bpmn:messageEventDefinition/></bpmn:startEvent>
<bpmn:task id="Task_1" name="Telecharger la copie de l'eleve"/>
<bpmn:task id="Task_2" name="Telecharger le corrige de reference"/>
<bpmn:task id="Task_3" name="OCR de la copie (Mistral)"/>
<bpmn:task id="Task_4" name="OCR du corrige (Mistral)"/>
<bpmn:parallelGateway id="Gateway_1" name="Fusion copie + corrige"/>
<bpmn:task id="Task_5" name="Comparer copie vs corrige (Agent + LLM)"/>
<bpmn:task id="Task_6" name="Extraire note et commentaires (JSON)"/>
<bpmn:parallelGateway id="Gateway_2" name="Repartir vers les sorties"/>
<bpmn:task id="Task_7" name="Enregistrer la correction (Supabase)"/>
<bpmn:endEvent id="EndEvent_1" name="Correction enregistree"/>
<bpmn:task id="Task_8" name="Creer et remplir le rapport (Google Docs)"/>
<bpmn:endEvent id="EndEvent_2" name="Rapport genere"/>
<bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
<bpmn:sequenceFlow id="Flow_2" sourceRef="StartEvent_1" targetRef="Task_2"/>
<bpmn:sequenceFlow id="Flow_3" sourceRef="Task_1" targetRef="Task_3"/>
<bpmn:sequenceFlow id="Flow_4" sourceRef="Task_2" targetRef="Task_4"/>
