<bpmn:sequenceFlow id="Flow_8" sourceRef="Task_5" targetRef="Task_6"/>
<bpmn:sequenceFlow id="Flow_9" sourceRef="Task_6" targetRef="Gateway_2"/>
<bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_2" targetRef="Task_7"/>
<bpmn:sequenceFlow id="Flow_11" sourceRef="Task_7" targetRef="EndEvent_1"/>
<bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_2" targetRef="Task_8"/>
<bpmn:sequenceFlow id="Flow_13" sourceRef="Task_8" targetRef="EndEvent_2"/>
</bpmn:process>
